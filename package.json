{
  "name": "invoiceops-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Invoice lifecycle platform with container delivery, Kubernetes and operational telemetry",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests web scripts",
    "format": "biome check --write src tests web scripts",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/integration/*.test.js",
    "verify": "npm run lint && npm run test",
    "start": "node dist/src/main.js",
    "init": "node scripts/init-env.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
